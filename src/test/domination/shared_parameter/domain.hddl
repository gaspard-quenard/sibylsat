; ownerB's argument ?y shares its Q-constant with ownerA's ?x. Replacing ownerB's (p c) by ownerA's (p ?x)
; would force that Q-constant to c under ownerB, whose goalsuffix needs it to be d: the only plan would be lost.
(define (domain capturetest)
 (:requirements :hierarchy :typing :method-preconditions)
 (:types item) (:constants c - item)
 (:predicates (eligible ?v - item) (broad ?v - item) (touched ?v - item) (marked ?v - item) (z1) (z2))
 (:task main :parameters ())
 (:task failsuffix :parameters ())
 (:task goalsuffix :parameters (?v - item))
 (:method ownerA :parameters (?x - item) :task (main) :precondition (eligible ?x)
  :ordered-subtasks (and (p ?x) (failsuffix)))
 (:method ownerB :parameters (?y - item) :task (main) :precondition (and (eligible ?y) (broad ?y))
  :ordered-subtasks (and (p c) (goalsuffix ?y)))
 (:method fail1 :parameters () :task (failsuffix) :ordered-subtasks (nop1))
 (:method fail2 :parameters () :task (failsuffix) :ordered-subtasks (nop2))
 (:method goal1 :parameters (?v - item) :task (goalsuffix ?v) :ordered-subtasks (q1 ?v))
 (:method goal2 :parameters (?v - item) :task (goalsuffix ?v) :ordered-subtasks (q2 ?v))
 (:action p :parameters (?v - item) :effect (touched ?v))
 (:action nop1 :parameters () :effect (z1))
 (:action nop2 :parameters () :effect (z2))
 (:action q1 :parameters (?v - item) :effect (marked ?v))
 (:action q2 :parameters (?v - item) :effect (and (marked ?v) (z2))))
