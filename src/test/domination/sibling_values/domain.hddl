; Replacing ownerB's (tp c) and (tr d) by ownerA's (tp ?x) and (tr ?x) would force ?x's Q-constant to c and to d
; under ownerB: the only plan (ownerB) would be lost.
(define (domain siblingcapture)
 (:requirements :hierarchy :typing :method-preconditions)
 (:types item) (:constants c d - item)
 (:predicates (eligible ?v - item) (touched ?v - item) (seen ?v - item) (finished) (z1) (z2))
 (:task main :parameters ())
 (:task tp :parameters (?v - item))
 (:task tr :parameters (?v - item))
 (:task failsuffix :parameters ())
 (:task goalsuffix :parameters ())
 (:method ownerA :parameters (?x - item) :task (main) :precondition (eligible ?x)
  :ordered-subtasks (and (tp ?x) (tr ?x) (failsuffix)))
 (:method ownerB :parameters () :task (main) :precondition (eligible c)
  :ordered-subtasks (and (tp c) (tr d) (goalsuffix)))
 (:method tp1 :parameters (?v - item) :task (tp ?v) :ordered-subtasks (p ?v))
 (:method tp2 :parameters (?v - item) :task (tp ?v) :ordered-subtasks (p2 ?v))
 (:method tr1 :parameters (?v - item) :task (tr ?v) :ordered-subtasks (r ?v))
 (:method tr2 :parameters (?v - item) :task (tr ?v) :ordered-subtasks (r2 ?v))
 (:method fail1 :parameters () :task (failsuffix) :ordered-subtasks (nop1))
 (:method fail2 :parameters () :task (failsuffix) :ordered-subtasks (nop2))
 (:method goal1 :parameters () :task (goalsuffix) :ordered-subtasks (finish1))
 (:method goal2 :parameters () :task (goalsuffix) :ordered-subtasks (finish2))
 (:action p :parameters (?v - item) :effect (touched ?v))
 (:action p2 :parameters (?v - item) :effect (and (touched ?v) (z1)))
 (:action r :parameters (?v - item) :effect (seen ?v))
 (:action r2 :parameters (?v - item) :effect (and (seen ?v) (z1)))
 (:action nop1 :parameters () :effect (z1))
 (:action nop2 :parameters () :effect (z2))
 (:action finish1 :parameters () :effect (finished))
 (:action finish2 :parameters () :effect (and (finished) (z2))))
