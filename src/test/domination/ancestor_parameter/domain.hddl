; gA's and gB's ?z share a Q-constant. Replacing in1's (tp c) by inq1's (tp ?v), where ?v is that Q-constant, would
; force it to c under in1, but in1's parent gA needs it to be d (finish ?z): the only plan would be lost.
(define (domain ancestorcapture)
 (:requirements :hierarchy :typing :method-preconditions)
 (:types item) (:constants c d - item)
 (:predicates (eligible ?v - item) (touched ?v - item) (marked ?v - item) (z1) (z2))
 (:task main :parameters ())
 (:task inner :parameters ())
 (:task innerq :parameters (?v - item))
 (:task tp :parameters (?v - item))
 (:task finish :parameters (?v - item))
 (:task failsuffix :parameters ())
 (:method gA :parameters (?z - item) :task (main) :precondition (eligible ?z)
  :ordered-subtasks (and (inner) (finish ?z)))
 (:method gB :parameters (?z - item) :task (main) :precondition (eligible ?z)
  :ordered-subtasks (and (innerq ?z) (failsuffix)))
 (:method in1 :parameters () :task (inner) :ordered-subtasks (tp c))
 (:method in2 :parameters () :task (inner) :ordered-subtasks (tp c))
 (:method inq1 :parameters (?v - item) :task (innerq ?v) :ordered-subtasks (tp ?v))
 (:method inq2 :parameters (?v - item) :task (innerq ?v) :ordered-subtasks (tp ?v))
 (:method tp1 :parameters (?v - item) :task (tp ?v) :ordered-subtasks (p ?v))
 (:method tp2 :parameters (?v - item) :task (tp ?v) :ordered-subtasks (p2 ?v))
 (:method fin1 :parameters (?v - item) :task (finish ?v) :ordered-subtasks (q1 ?v))
 (:method fin2 :parameters (?v - item) :task (finish ?v) :ordered-subtasks (q2 ?v))
 (:method fail1 :parameters () :task (failsuffix) :ordered-subtasks (nop1))
 (:method fail2 :parameters () :task (failsuffix) :ordered-subtasks (nop2))
 (:action p :parameters (?v - item) :effect (touched ?v))
 (:action p2 :parameters (?v - item) :effect (and (touched ?v) (z1)))
 (:action q1 :parameters (?v - item) :effect (marked ?v))
 (:action q2 :parameters (?v - item) :effect (and (marked ?v) (z2)))
 (:action nop1 :parameters () :effect (z1))
 (:action nop2 :parameters () :effect (z2)))
