+void MsSolver::removeNonReusableCores() {
+    // Remove all saved cores which are based on soft literals that are no longer relevant
+
+    // Get all the soft literals which have been deleted since the last call to this function
+    vec<Lit> soft_literals_deleted;
+    vec<Lit> current_soft_literals;
+    
+    // Collect current soft literals
+    for (int i = 0; i < soft_cls.size(); i++) {
+        // If weight is 0, it means that the soft clause is no longer relevant
+        if (soft_cls[i].fst == 0) continue;
+        Minisat::vec<Lit>* clause = soft_cls[i].snd;
+        for (int j = 0; j < clause->size(); j++) {
+            current_soft_literals.push((*clause)[j]);
+        }
+    }
+    
+    // Sort current soft literals for efficient search
+    Sort::sort(current_soft_literals);
+
+    // Find deleted soft literals by comparing with the previous set
+    for (int i = 0; i < previous_soft_cls.size(); i++) {
+        const Lit& previous_lit = previous_soft_cls[i];
+        if (Sort::bin_search(current_soft_literals, previous_lit) == -1) {
+            soft_literals_deleted.push(previous_lit);
+        }
+    }
+
+    // Add deleted literals to the list for removal
+    vec<Lit> lits_to_delete;
+    for (int i = 0; i < soft_literals_deleted.size(); i++) {
+        lits_to_delete.push(soft_literals_deleted[i]);
+    }
+
+    int num_cores = saved_cores.size();
+    Minisat::vec<bool> none;
+    int num_cores_deleted = forgetCores(lits_to_delete, none);
+
+    // Print the number of cores deleted
+    printf("Done! Number of cores deleted: %d/%d\n", num_cores_deleted, num_cores);
+
+    // Update previous soft clauses
+    previous_soft_cls.clear();
+    for (int i = 0; i < current_soft_literals.size(); i++) {
+        previous_soft_cls.push(current_soft_literals[i]);
+    }
+}
+
+int MsSolver::forgetCores(vec<Lit>& lits_to_delete, const Minisat::vec<bool>& refuted) {
+    // Forgets the saved cores marked in `refuted` and those that contain one of the (sorted) literals. The constraint
+    // literals that a forgotten core introduced join the literals, so that the cores built on them are forgotten too
+    // (a core comes after the cores whose constraint literals it contains). Returns the number of cores forgotten.
+    int num_cores = saved_cores.size(), kept = 0;
+    for (int i = 0; i < num_cores; i++) {
+        bool forget = i < refuted.size() && refuted[i];
+        for (int j = 0; !forget && j < saved_cores[i].size(); j++)
+            forget = Sort::bin_search(lits_to_delete, ~saved_cores[i][j]) != -1;
+        if (forget) {
+            for (int j = 0; j < core_to_constrains_lits[i].size(); j++)
+                lits_to_delete.push(core_to_constrains_lits[i][j]);
+            Sort::sort(lits_to_delete);
+        } else {
+            if (kept < i) {
+                saved_cores[i].moveTo(saved_cores[kept]);
+                core_to_constrains_lits[i].moveTo(core_to_constrains_lits[kept]);
+                core_global_assumptions[i].moveTo(core_global_assumptions[kept]);
+            }
+            kept++;
+        }
+    }
+    saved_cores.shrink(num_cores - kept);
+    core_to_constrains_lits.shrink(num_cores - kept);
+    core_global_assumptions.shrink(num_cores - kept);
+    return num_cores - kept;
+}
+
+lbool MsSolver::proveSavedCore(const Minisat::vec<Lit>& core) {
+    // A saved core was found in an earlier call, with what held in that call only: the soft literals hardened from
+    // its bounds, its unit cores, and constraint literals that the current call builds again, not always with the
+    // same bound. None of this is recorded with the core, so the SAT solver is asked whether the assumptions of the
+    // core can all hold now, under the assumptions and the hardened literals of the current call.
+    // l_False: they cannot, it is a core of this call. l_True: they can. l_Undef: the solver was interrupted.
+    Minisat::vec<Lit> assumptions;
+    for (int i = 0; i < core.size(); i++) assumptions.push(~core[i]);
+    return satSolveLimited(assumptions);
+}
+
+int MsSolver::findReusableCore(const Minisat::vec<bool>& core_usage_flags, const Minisat::vec<Lit>& assump_ps) {
+    // Iterate through saved cores to find one that can be reused with the current assumptions.
+    for (int core_idx = 0; core_idx < saved_cores.size(); ++core_idx) {
+        if (core_usage_flags[core_idx]) continue; // Skip already used cores
+
+        // A core found under IPAMIR assumptions is only valid while those
+        // assumptions still hold. The soft-literal subset check alone is not
+        // enough: primitive-plan assumptions disappear in the next abstract solve.
+        bool assumptions_hold = true;
+        for (int lit_idx = 0; lit_idx < core_global_assumptions[core_idx].size(); ++lit_idx) {
+            if (Sort::bin_search(global_assumptions, core_global_assumptions[core_idx][lit_idx]) == -1) {
+                assumptions_hold = false;
+                break;
+            }
+        }
+        if (!assumptions_hold) continue;
+
+        // Check if all literals in this core are present in the current assumptions
+        bool is_subset = true;
+        for (int lit_idx = 0; lit_idx < saved_cores[core_idx].size(); ++lit_idx) {
+            if (Sort::bin_search(assump_ps, ~saved_cores[core_idx][lit_idx]) == -1) {
+                is_subset = false;
+                break;
+            }
+        }
+        
+        if (is_subset) {
+            return core_idx; // Return the index of the reusable core
+        }
+    }
+    return -1; // No reusable core found
+}
 
